# Copier ce fichier en .env et renseigner les valeurs locales ou de plateforme.
# Ne jamais committer le fichier .env.

# Application
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO

# Backend FastAPI, vu depuis Streamlit
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT_SECONDS=10

# WhatsApp Cloud API (Meta for Developers)
# Laisser WA_ENABLED=false tant que l'app Meta n'est pas configurée.
WA_ENABLED=false
WA_API_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Hugging Face, optionnel
HF_TOKEN=

# Streamlit local
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
