# Copier ce fichier en .env et renseigner les valeurs locales ou de plateforme.
# Ne jamais committer le fichier .env.

# Application
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO

# Backend FastAPI, vu depuis Streamlit
BACKEND_URL=http://localhost:8000

# OpenWA
# Laisser false tant que le service OpenWA n'est pas configuré.
OPENWA_ENABLED=false
OPENWA_API_URL=http://localhost:8080
OPENWA_API_KEY=
OPENWA_INSTANCE_ID=

# Protection des requêtes webhook OpenWA
WEBHOOK_SECRET=

# Fallback Twilio optionnel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Hugging Face, optionnel
HF_TOKEN=

# OpenAI, optionnel
OPENAI_API_KEY=

# Streamlit local
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
